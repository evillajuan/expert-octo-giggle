# Copy this to .env and fill in your values
# Get your Stripe Payment Link from dashboard.stripe.com > Payment Links
VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/YOUR_LINK_HERE

# Get your Formspree form ID from formspree.io (free tier)
VITE_FORMSPREE_ID=YOUR_FORM_ID

# URL of your Netlify backend (set in GitHub Actions secret VITE_API_BASE_URL)
# Leave empty when running locally with `netlify dev`
VITE_API_BASE_URL=https://your-site.netlify.app

# Server-only — set this in the Netlify dashboard (Environment Variables), NOT in .env
# ANTHROPIC_API_KEY=sk-ant-...
